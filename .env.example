# JalRakshak — Environment Configuration Template
# Copy this file to .env and supply your project credentials to connect Supabase.
# If left blank, JalRakshak will automatically run in zero-config Local Demo Mode.

# 1. Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=

# 2. Supabase Anonymous Public Key (Project Settings -> API -> Project API keys -> anon/public)
# NOTE: Never put service_role secret keys in client-side code!
VITE_SUPABASE_ANON_KEY=

# 3. India Meteorological Department (IMD) API Access (Optional)
# Public API reference: https://api.imd.gov.in/public/api_reference.html
# Institutional API token for Station 42182 (Safdarjung Observatory / New Delhi).
# If omitted, JalRakshak transparently uses the verified Open-Meteo public feed and NWDP telemetry.
VITE_IMD_API_KEY=

# 4. Development overrides (optional)
# Set to true to force local demo mode even if Supabase variables are set
VITE_FORCE_LOCAL_DEMO=false
